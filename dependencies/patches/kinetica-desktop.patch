+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package io.heapy.kinetica.appkit
+
+import io.heapy.kinetica.*
+import io.heapy.kinetica.canvas.*
+import kotlinx.serialization.json.Json
+import platform.AppKit.*
+import platform.Foundation.*
+import kotlin.test.*
+
+class AppKitCanvasTest {
+    @Test fun resizeUsesLogicalCoordinatesAndDisposalStopsInput() {
+        NSApplication.sharedApplication()
+        val events = mutableListOf<CanvasInput>()
+        val view = AppKitCanvas { events += it }
+        view.update(CanvasModel(640.0, 480.0, CanvasColor(1.0,1.0,1.0), emptyList()))
+        view.setFrameSize(NSMakeSize(800.0, 600.0))
+        assertEquals(CanvasInput.Resize(800.0,600.0), events.last())
+        val count = events.size
+        view.setFrameSize(NSMakeSize(800.0,600.0))
+        assertEquals(count, events.size)
+        view.dispose()
+        view.setFrameSize(NSMakeSize(900.0,600.0))
+        assertEquals(count, events.size)
+    }
+
+    @Test fun rendererRetainsCanvasAndSupportsFocusAndUnmount() {
+        NSApplication.sharedApplication()
+        val window = NSWindow(NSMakeRect(0.0,0.0,640.0,480.0), NSWindowStyleMaskTitled, NSBackingStoreBuffered, false)
+        window.setReleasedWhenClosed(false)
+        var shown = true
+        var model = CanvasModel(640.0,480.0,CanvasColor(1.0,1.0,1.0),emptyList())
+        val app = renderAppKitApp(window.contentView!!) {
+            column { if(shown) canvas(model, onInput = {}, semantics = Semantics(testTag="canvas",focusable=true)) }
+        }
+        try {
+            val root = window.contentView!!.subviews.single() as NSView
+            val view = root.subviews.single() as AppKitCanvas
+            assertTrue(app.focus("canvas"))
+            assertEquals(view,window.firstResponder)
+            model = model.copy(shapes = listOf(CanvasShape.Circle(20.0,20.0,5.0,fill=CanvasColor(1.0,0.0,0.0))))
+            app.render()
+            assertSame(view,root.subviews.single())
+            shown = false; app.render()
+            assertFalse(app.focus("canvas"))
+            assertTrue(root.subviews.isEmpty())
+        } finally { app.dispose(); window.close() }
+    }
+
+    @Test fun canvasModelRoundTripsAndRejectsInvalidGeometry() {
+        val model = CanvasModel(400.0,300.0,CanvasColor(1.0,1.0,1.0),listOf(
+            CanvasShape.Polygon(listOf(CanvasPoint(0.0,0.0),CanvasPoint(10.0,0.0),CanvasPoint(0.0,10.0)),CanvasColor(1.0,0.0,0.0,.2))))
+        assertEquals(model,Json.decodeFromString<CanvasModel>(Json.encodeToString(model)))
+        assertFailsWith<IllegalArgumentException> { model.copy(width=0.0) }
+        assertFailsWith<IllegalArgumentException> { CanvasColor(Double.NaN,0.0,0.0) }
+        assertFailsWith<IllegalArgumentException> { CanvasShape.Polygon(emptyList(),CanvasColor(0.0,0.0,0.0)) }
+    }
+}
