+package io.heapy.kinetica.canvas
+
+import io.heapy.kinetica.*
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.json.Json
+
+@Serializable
+public data class CanvasColor(val red: Double, val green: Double, val blue: Double, val alpha: Double = 1.0) {
+    init { require(listOf(red, green, blue, alpha).all { it.isFinite() && it in 0.0..1.0 }) }
+}
+
+@Serializable
+public data class CanvasPoint(val x: Double, val y: Double)
+
+@Serializable
+public sealed interface CanvasShape {
+    @Serializable public data class Polygon(val points: List<CanvasPoint>, val fill: CanvasColor) : CanvasShape {
+        init { require(points.size >= 3 && points.all { it.x.isFinite() && it.y.isFinite() }) }
+    }
+    @Serializable public data class Line(val x1: Double, val y1: Double, val x2: Double, val y2: Double,
+        val color: CanvasColor, val width: Double = 1.0) : CanvasShape
+    @Serializable public data class Rectangle(val x: Double, val y: Double, val width: Double, val height: Double,
+        val fill: CanvasColor) : CanvasShape
+    @Serializable public data class Circle(val x: Double, val y: Double, val radius: Double,
+        val fill: CanvasColor? = null, val stroke: CanvasColor? = null, val strokeWidth: Double = 1.0) : CanvasShape
+}
+
+/** Coordinates use logical points with a top-left origin. This model contains no platform types. */
+@Serializable
+public data class CanvasModel(val width: Double, val height: Double, val background: CanvasColor,
+    val shapes: List<CanvasShape>) {
+    init { require(width.isFinite() && height.isFinite() && width > 0 && height > 0) }
+}
+
+public sealed interface CanvasInput {
+    public data class Resize(val width: Double, val height: Double) : CanvasInput
+    public data class Pointer(val phase: PointerPhase, val x: Double, val y: Double) : CanvasInput
+    public data class Scroll(val x: Double, val y: Double, val deltaY: Double) : CanvasInput
+    public data class Zoom(val x: Double, val y: Double, val factor: Double) : CanvasInput
+    public data class Key(val key: String, val shift: Boolean = false) : CanvasInput
+}
+public enum class PointerPhase { DOWN, MOVE, UP }
+public const val CANVAS_TAG: String = "kinetica:canvas"
+
+/** Retained leaf canvas. Backend availability is documented by each renderer. */
+@UiComponent
+public fun ComponentScope.canvas(model: CanvasModel, onInput: (CanvasInput) -> Unit,
+    semantics: Semantics = Semantics(label = "Canvas", focusable = true), key: Any? = null,
+    minWidth: Double = 240.0, minHeight: Double = 240.0) {
+    val event = hostEvent<CanvasInput>(onEvent = onInput)
+    host(CANVAS_TAG, props = mapOf("model" to Json.encodeToString(model), "event:onCanvas" to event,
+        "minWidth" to minWidth.toString(), "minHeight" to minHeight.toString()), semantics = semantics, key = key)
+}
