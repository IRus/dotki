+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package io.heapy.kinetica.desktop
+
+import io.heapy.kinetica.*
+import io.heapy.kinetica.application.*
+import io.heapy.kinetica.appkit.*
+import platform.AppKit.NSPasteboard
+import platform.AppKit.NSPasteboardTypeString
+
+/** Single-window desktop entry point. Native delegates, menus and editing stay in Kinetica. */
+public fun runDesktopApplication(
+    name: String,
+    window: ApplicationWindow = ApplicationWindow("main", name),
+    release: (() -> Unit) -> Unit = { it() },
+    content: @UiComponent ComponentScope.() -> Unit,
+) {
+    val app = AppKitApplication(name)
+    app.commands.register(ApplicationCommand("app.quit", "Quit $name", listOf(KeyShortcut("q"))) { app.requestQuit() })
+    app.commands.register(ApplicationCommand("app.hide", "Hide $name", listOf(KeyShortcut("h"))) { app.hide() })
+    app.commands.register(ApplicationCommand("window.close", "Close Window", listOf(KeyShortcut("w")), windowRequired = true) { app.activeWindow?.close() })
+    app.editingCommand("edit.cut", "Cut", KeyShortcut("x"), EditingCommand.CUT)
+    app.editingCommand("edit.copy", "Copy", KeyShortcut("c"), EditingCommand.COPY)
+    app.editingCommand("edit.paste", "Paste", KeyShortcut("v"), EditingCommand.PASTE)
+    app.editingCommand("edit.selectAll", "Select All", KeyShortcut("a"), EditingCommand.SELECT_ALL)
+    app.editingCommand("edit.undo", "Undo", KeyShortcut("z"), EditingCommand.UNDO)
+    app.setMenus(listOf(ApplicationMenu(name, listOf(MenuItem.Command("app.hide"), MenuItem.Command("app.quit"))),
+        ApplicationMenu("Edit", listOf("edit.undo", "edit.cut", "edit.copy", "edit.paste", "edit.selectAll").map { MenuItem.Command(it) }),
+        ApplicationMenu("Window", listOf(MenuItem.Command("window.close")))))
+    try {
+        app.install()
+        app.openWindow(window, callbacks = WindowCallbacks(release = release), content = content)
+        app.run()
+    } finally { app.dispose() }
+}
+
+public fun copyTextToClipboard(text: String) {
+    val clipboard = NSPasteboard.generalPasteboard
+    clipboard.clearContents()
+    clipboard.setString(text, forType = NSPasteboardTypeString)
+}
+
+@UiComponent
+public fun ComponentScope.label(value: String, fontSize: Double = 13.0, secondary: Boolean = false, semantics: Semantics? = null) {
+    host("appkit:label", props = mapOf("value" to value, "fontSize" to fontSize.toString(), "secondary" to secondary.toString()), semantics = semantics)
+}
