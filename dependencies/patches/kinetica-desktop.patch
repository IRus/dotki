+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package io.heapy.kinetica.desktop.testing
+
+import io.heapy.kinetica.*
+import io.heapy.kinetica.application.WindowSize
+import io.heapy.kinetica.appkit.renderAppKitApp
+import kotlinx.cinterop.*
+import platform.AppKit.*
+import platform.Foundation.*
+
+/** Render an owned offscreen view to PNG. Does not inspect or control other applications.
+ * Call on the native UI thread. Useful for application previews and rendering tests. */
+public fun desktopPreviewPng(size: WindowSize, content: @UiComponent ComponentScope.() -> Unit): ByteArray {
+    NSApplication.sharedApplication()
+    val window = NSWindow(NSMakeRect(0.0,0.0,size.width,size.height), NSWindowStyleMaskTitled, NSBackingStoreBuffered, false)
+    window.setReleasedWhenClosed(false)
+    window.appearance = NSAppearance.appearanceNamed(NSAppearanceNameAqua)
+    val view = PreviewBackground(NSMakeRect(0.0,0.0,size.width,size.height))
+    window.contentView = view
+    val renderer = renderAppKitApp(view, content = content)
+    try {
+        repeat(3) {
+            view.layoutSubtreeIfNeeded()
+            NSRunLoop.currentRunLoop.runUntilDate(NSDate.dateWithTimeIntervalSinceNow(0.02))
+            renderer.renderUntilSettled()
+        }
+        view.layoutSubtreeIfNeeded()
+        val bitmap = requireNotNull(view.bitmapImageRepForCachingDisplayInRect(view.bounds))
+        view.effectiveAppearance.performAsCurrentDrawingAppearance {
+            view.cacheDisplayInRect(view.bounds, toBitmapImageRep = bitmap)
+        }
+        val data = requireNotNull(bitmap.representationUsingType(NSBitmapImageFileType.NSBitmapImageFileTypePNG, properties = emptyMap<Any?, Any>()))
+        return requireNotNull(data.bytes).reinterpret<ByteVar>().readBytes(data.length.toInt())
+    } finally { renderer.dispose(); window.close() }
+}
+
+private class PreviewBackground(frame: CValue<NSRect>) : NSView(frame) {
+    override fun drawRect(dirtyRect: CValue<NSRect>) {
+        NSColor.windowBackgroundColor.setFill()
+        NSRectFill(bounds)
+    }
+}
