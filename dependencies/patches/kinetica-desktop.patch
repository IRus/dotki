+@file:OptIn(kotlinx.cinterop.ExperimentalForeignApi::class)
+package io.heapy.kinetica.appkit
+
+import io.heapy.kinetica.canvas.*
+import kotlinx.cinterop.*
+import platform.AppKit.*
+import platform.Foundation.*
+
+/** Framework-owned canvas: applications only see CanvasModel and CanvasInput. */
+internal class AppKitCanvas(private var input: ((CanvasInput) -> Unit)?) : NSView(NSMakeRect(0.0, 0.0, 640.0, 640.0)) {
+    private var model: CanvasModel? = null
+    private var lastWidth = 0.0
+    private var lastHeight = 0.0
+
+    init {
+        setContentHuggingPriority(1f, NSUserInterfaceLayoutOrientationHorizontal)
+        setContentHuggingPriority(1f, NSUserInterfaceLayoutOrientationVertical)
+        setContentCompressionResistancePriority(1f, NSUserInterfaceLayoutOrientationHorizontal)
+        setContentCompressionResistancePriority(1f, NSUserInterfaceLayoutOrientationVertical)
+    }
+
+    override fun isFlipped(): Boolean = true
+    override fun acceptsFirstResponder(): Boolean = true
+    override fun acceptsFirstMouse(event: NSEvent?): Boolean = true
+
+    fun update(next: CanvasModel) { if (model != next) { model = next; setNeedsDisplay(true) } }
+    fun dispose() { input = null; model = null }
+
+    override fun setFrameSize(newSize: CValue<NSSize>) {
+        super.setFrameSize(newSize)
+        newSize.useContents {
+            if (width > 0 && height > 0 && (width != lastWidth || height != lastHeight)) {
+                lastWidth = width; lastHeight = height
+                input?.invoke(CanvasInput.Resize(width, height))
+            }
+        }
+    }
+
+    override fun drawRect(dirtyRect: CValue<NSRect>) {
+        val scene = model ?: return
+        NSGraphicsContext.saveGraphicsState()
+        try {
+            NSBezierPath.bezierPathWithRect(bounds).addClip()
+            scene.background.native().setFill()
+            NSRectFill(bounds)
+            val transform = NSAffineTransform.transform()
+            bounds.useContents { transform.scaleXBy(size.width / scene.width, yBy = size.height / scene.height) }
+            transform.concat()
+            for (shape in scene.shapes) when (shape) {
+                is CanvasShape.Polygon -> {
+                    val path = NSBezierPath.bezierPath()
+                    path.moveToPoint(NSMakePoint(shape.points.first().x, shape.points.first().y))
+                    shape.points.drop(1).forEach { path.lineToPoint(NSMakePoint(it.x, it.y)) }
+                    path.closePath(); shape.fill.native().setFill(); path.fill()
+                }
+                is CanvasShape.Line -> {
+                    if (!listOf(shape.x1, shape.y1, shape.x2, shape.y2, shape.width).all(Double::isFinite)) continue
+                    val path = NSBezierPath.bezierPath()
+                    path.moveToPoint(NSMakePoint(shape.x1, shape.y1)); path.lineToPoint(NSMakePoint(shape.x2, shape.y2))
+                    path.setLineWidth(shape.width.coerceAtLeast(0.1)); shape.color.native().setStroke(); path.stroke()
+                }
+                is CanvasShape.Rectangle -> {
+                    if (!listOf(shape.x, shape.y, shape.width, shape.height).all(Double::isFinite) || shape.width < 0 || shape.height < 0) continue
+                    shape.fill.native().setFill(); NSRectFill(NSMakeRect(shape.x, shape.y, shape.width, shape.height))
+                }
+                is CanvasShape.Circle -> {
+                    if (!listOf(shape.x, shape.y, shape.radius, shape.strokeWidth).all(Double::isFinite) || shape.radius < 0) continue
+                    val path = NSBezierPath.bezierPathWithOvalInRect(NSMakeRect(shape.x - shape.radius, shape.y - shape.radius, shape.radius * 2, shape.radius * 2))
+                    shape.fill?.let { it.native().setFill(); path.fill() }
+                    shape.stroke?.let { it.native().setStroke(); path.setLineWidth(shape.strokeWidth.coerceAtLeast(0.1)); path.stroke() }
+                }
+            }
+        } finally { NSGraphicsContext.restoreGraphicsState() }
+    }
+
+    private fun point(event: NSEvent): Pair<Double, Double> {
+        val scene = model
+        return convertPoint(event.locationInWindow, fromView = null).useContents {
+            val bw = bounds.useContents { size.width }; val bh = bounds.useContents { size.height }
+            x * (scene?.width ?: bw) / bw.coerceAtLeast(1.0) to y * (scene?.height ?: bh) / bh.coerceAtLeast(1.0)
+        }
+    }
+    private fun pointer(event: NSEvent, phase: PointerPhase) {
+        val (x, y) = point(event); input?.invoke(CanvasInput.Pointer(phase, x, y))
+    }
+    override fun mouseDown(event: NSEvent) { window?.makeFirstResponder(this); pointer(event, PointerPhase.DOWN) }
+    override fun mouseDragged(event: NSEvent) { pointer(event, PointerPhase.MOVE) }
+    override fun mouseUp(event: NSEvent) { pointer(event, PointerPhase.UP) }
+    override fun scrollWheel(event: NSEvent) {
+        val (x, y) = point(event)
+        input?.invoke(CanvasInput.Scroll(x, y, -event.scrollingDeltaY * if (event.hasPreciseScrollingDeltas) 1 else 12))
+    }
+    override fun magnifyWithEvent(event: NSEvent) {
+        val (x, y) = point(event); input?.invoke(CanvasInput.Zoom(x, y, (1 + event.magnification).coerceAtLeast(0.1)))
+    }
+    override fun keyDown(event: NSEvent) {
+        val key = when (event.keyCode.toInt()) {
+            123 -> "ArrowLeft"; 124 -> "ArrowRight"; 125 -> "ArrowDown"; 126 -> "ArrowUp"
+            36, 76 -> "Enter"; 49 -> " "; 115 -> "Home"; 53 -> "Escape"
+            else -> event.charactersIgnoringModifiers.orEmpty()
+        }
+        if (key in setOf("ArrowLeft", "ArrowRight", "ArrowDown", "ArrowUp", "Enter", " ", "Home", "Escape", "+", "=", "-"))
+            input?.invoke(CanvasInput.Key(key, event.modifierFlags and NSEventModifierFlagShift != 0uL))
+        else super.keyDown(event)
+    }
+}
+
+private fun CanvasColor.native(): NSColor = NSColor.colorWithCalibratedRed(red, green, blue, alpha)
